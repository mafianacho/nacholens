          "request": "UPDATE name, email, age WHERE id",
          "response": "ok or error"
        },
        {
          "id": "done",
          "kind": "response",
          "from": "server",
          "to": "client",
          "label": "Reply: updated",
          "narration": "The server answers 200 with the message 'Student updated' (or 500 if the database fails).",
          "evidence": [
            {
              "file": "internal/http/handlers/student/student.go",
              "lines": [
                91,
                91
              ],
              "contains": "Student updated"
            }
          ],
          "response": "200 {message}"
        }
      ]
