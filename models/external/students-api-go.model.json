  "product": {
    "id": "students-api-go",
    "name": "Students API",
    "description": "A small student-records service: a caller adds, lists, updates and deletes students, and the service keeps them in a local SQLite file."
  },
  "source": {
    "repo": "ashankgupta/students-api-go",
    "commit": "6a339a28eaacf660a9425ce5efe57011b9977bad"
  },
