  "useCases": [
    {
      "id": "add-student",
      "title": "Add a student",
      "summary": "A caller sends name, email and age; the service checks them and stores a new student.",
      "trigger": "POST /api/students",
      "steps": [
        {
          "id": "req",
          "kind": "request",
          "from": "client",
          "to": "server",
          "label": "Send the new student",
          "narration": "The caller posts a student's details to the students address. The server sees it is a 'create' request.",
          "evidence": [
            {
              "file": "cmd/students-api/main.go",
              "lines": [
                32,
                32
              ],
              "contains": "POST /api/students"
            },
            {
              "file": "internal/http/handlers/student/student.go",
              "lines": [
                21,
                22
              ],
              "contains": "case http.MethodPost"
            }
          ],
          "request": "POST /api/students {name, email, age}"
        },
        {
          "id": "read",
          "kind": "internal",
          "from": "server",
          "to": "server",
          "label": "Read the request body",
          "narration": "The server reads the details sent. An empty or unreadable body is turned away with a 400 error.",
          "evidence": [
            {
              "file": "internal/http/handlers/student/student.go",
              "lines": [
                39,
                47
              ],
              "contains": "json.NewDecoder(r.Body).Decode(&student)"
            }
          ]
        },
        {
          "id": "validate",
          "kind": "internal",
          "from": "server",
          "to": "server",
          "label": "Check required fields",
          "narration": "Name, email and age must all be filled in; otherwise the server answers 400 and says which field is missing.",
          "evidence": [
            {
              "file": "internal/http/handlers/student/student.go",
              "lines": [
                49,
                53
              ],
              "contains": "validator.New().Struct(student)"
            }
          ]
        },
        {
          "id": "insert",
          "kind": "call",
          "from": "server",
          "to": "db",
          "label": "Save the student",
          "narration": "The server asks the database to insert a new row and receives the new student's number.",
          "evidence": [
            {
              "file": "internal/http/handlers/student/student.go",
              "lines": [
                55,
                55
              ],
              "contains": "storage.CreateStudent"
            },
            {
              "file": "internal/storage/sqlite/sqlite.go",
              "lines": [
                43,
                43
              ],
              "contains": "INSERT INTO students"
            }
          ],
          "request": "INSERT name, email, age",
          "response": "new row id"
        },
        {
          "id": "done",
          "kind": "response",
          "from": "server",
          "to": "client",
          "label": "Reply: created",
          "narration": "The server answers 201 Created with the new student's id.",
          "evidence": [
            {
              "file": "internal/http/handlers/student/student.go",
              "lines": [
                62,
                62
              ],
              "contains": "http.StatusCreated"
            }
          ],
          "response": "201 {id}"
        }
      ]
    },
    {
      "id": "list-students",
      "title": "List all students",
      "summary": "A caller asks for everyone and gets back the full list.",
      "trigger": "GET /api/students",
      "steps": [
        {
          "id": "req",
          "kind": "request",
          "from": "client",
          "to": "server",
