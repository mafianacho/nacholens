            {
              "file": "internal/http/handlers/student/student.go",
              "lines": [
                73,
                73
              ],
              "contains": "http.StatusOK, students"
            }
          ],
          "response": "200 [students]"
        }
      ]
    },
    {
      "id": "update-student",
      "title": "Update a student",
      "summary": "A caller sends a student including its id and the stored details are overwritten.",
      "trigger": "PUT /api/students",
      "steps": [
        {
          "id": "req",
          "kind": "request",
          "from": "client",
          "to": "server",
          "label": "Send the changed student",
          "narration": "The caller sends the student with its id and the new details. The server sees it is an 'update' request.",
          "evidence": [
            {
              "file": "internal/http/handlers/student/student.go",
              "lines": [
                25,
                26
              ],
              "contains": "case http.MethodPut"
            }
          ],
          "request": "PUT /api/students {id, name, email, age}"
        },
        {
          "id": "check",
          "kind": "internal",
          "from": "server",
          "to": "server",
          "label": "Check the body and id",
          "narration": "If the body cannot be read or the id is missing/zero, the server answers 400 'Invalid input'. Unlike adding, name/email/age are not checked as required here.",
          "evidence": [
            {
              "file": "internal/http/handlers/student/student.go",
              "lines": [
                80,
                84
              ],
              "contains": "student.Id == 0"
            }
          ]
        },
        {
          "id": "update",
          "kind": "call",
          "from": "server",
          "to": "db",
          "label": "Overwrite the student",
          "narration": "The server asks the database to replace name, email and age of the student with that id.",
