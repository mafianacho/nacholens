    {
      "id": "client",
      "kind": "client",
      "label": "Caller\nany HTTP client",
      "detail": "Whoever calls the API (curl, a web page, another service). No client code exists in this repo; it is the party that sends requests to the /api/students address.",
      "evidence": [
        {
          "file": "cmd/students-api/main.go",
          "lines": [
            32,
            32
          ],
          "contains": "POST /api/students"
        }
      ]
    },
    {
      "id": "server",
      "kind": "service",
      "label": "Students API\nGo web server",
      "detail": "A Go net/http server that registers the students address and hands each request to one handler, which looks at the HTTP method and runs the matching action.",
      "evidence": [
        {
          "file": "cmd/students-api/main.go",
          "lines": [
            32,
            32
          ],
          "contains": "router.HandleFunc"
        },
        {
