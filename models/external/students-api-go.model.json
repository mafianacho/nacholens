          "lines": [
            20,
            31
          ],
          "contains": "switch r.Method"
        }
      ]
    },
    {
      "id": "db",
      "kind": "datastore",
      "label": "SQLite\nstudents table",
      "detail": "A local SQLite database file (path from the config file) holding one table, students, with id, name, email and age.",
      "evidence": [
        {
          "file": "internal/storage/sqlite/sqlite.go",
          "lines": [
            18,
            18
          ],
          "contains": "sql.Open(\"sqlite3\""
        }
      ]
    }
  ],
  "links": [
