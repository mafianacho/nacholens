  "useCases": [
    {
      "id": "sign-in",
      "title": "Sign in",
      "summary": "A user sends e-mail and password and receives an access token if they are correct and active.",
      "trigger": "POST /api/v1/login/access-token",
      "steps": [
        {
          "id": "req",
          "kind": "request",
          "from": "client",
          "to": "backend",
          "label": "Send e-mail and password",
          "narration": "The web app posts the login form to the backend; the proxy passes it on.",
          "via": [
            "gateway"
          ],
          "request": "POST /api/v1/login/access-token (e-mail, password)",
          "evidence": [
            {
              "file": "backend/app/api/routes/login.py",
              "lines": [
                23,
                26
              ],
              "contains": "login_access_token("
            }
          ]
        },
        {
          "id": "find",
          "kind": "call",
          "from": "backend",
          "to": "db",
          "label": "Find the user by e-mail",
          "narration": "The app looks up the account with this e-mail address.",
          "request": "Find user by e-mail",
          "response": "User record or nothing",
          "evidence": [
            {
              "file": "backend/app/crud.py",
              "lines": [
                35,
                35
              ],
              "contains": "select(User).where(User.email == email)"
            }
          ]
        },
        {
          "id": "check",
          "kind": "internal",
          "from": "backend",
          "to": "backend",
          "label": "Compare the password",
          "narration": "The typed password is compared with the stored scrambled version. If the e-mail is unknown, a fake comparison still runs so the timing does not give it away.",
          "evidence": [
            {
              "file": "backend/app/crud.py",
              "lines": [
                50,
                52
              ],
              "contains": "verify_password("
            }
          ]
        },
        {
          "id": "gate",
          "kind": "internal",
          "from": "backend",
          "to": "backend",
          "label": "Refuse wrong or inactive accounts",
          "narration": "A wrong e-mail/password or a deactivated account gets a 400 error and no token.",
          "evidence": [
            {
              "file": "backend/app/api/routes/login.py",
              "lines": [
                33,
                36
              ],
              "contains": "Incorrect email or password"
            }
          ]
        },
        {
          "id": "token",
          "kind": "internal",
          "from": "backend",
          "to": "backend",
          "label": "Create the access token",
          "narration": "A signed token is made that names the user and expires after a set time.",
          "evidence": [
            {
              "file": "backend/app/core/security.py",
              "lines": [
                24,
                26
              ],
              "contains": "jwt.encode("
            }
          ]
        },
        {
          "id": "resp",
          "kind": "response",
          "from": "backend",
          "to": "client",
          "label": "Return the token",
          "narration": "The token is sent back; the web app uses it for later requests.",
          "via": [
            "gateway"
          ],
          "response": "200 {access_token, token_type: bearer}",
          "evidence": [
            {
              "file": "backend/app/api/routes/login.py",
              "lines": [
                38,
                38
              ],
              "contains": "return Token("
            }
          ]
        }
      ]
    },
